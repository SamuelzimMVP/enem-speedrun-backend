# ═══════════════════════════════════════════════════════════
# ENEM Speedrun Backend — Configuração de Ambiente
# ═══════════════════════════════════════════════════════════

# ─── Servidor ──────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ─── Frontend (URL de produção) ────────────────────────────
FRONTEND_URL=https://enem-practice.vercel.app

# ─── Supabase ──────────────────────────────────────────────
# URL do seu projeto Supabase
SUPABASE_URL=https://SEU-PROJETO.supabase.co

# Chave ANON (pública, para operações normais do cliente)
# Obtida em: Supabase Dashboard > Settings > API > anon public
SUPABASE_ANON_KEY=sua-anon-key-aqui

# Chave SERVICE_ROLE (SECRETA — NUNCA expor no frontend!)
# Usada APENAS para operações admin (criar usuários, etc.)
# Obtida em: Supabase Dashboard > Settings > API > service_role secret
SUPABASE_SERVICE_KEY=sua-service-role-key-aqui
