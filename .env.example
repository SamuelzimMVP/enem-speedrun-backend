# ═══════════════════════════════════════════════════════════
# ENEM Speedrun Backend — Configuração de Ambiente
# ═══════════════════════════════════════════════════════════

# ─── Servidor ──────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ─── Frontend (URL de produção) ────────────────────────────
FRONTEND_URL=https://enem-practice.vercel.app

# ─── Supabase ──────────────────────────────────────────────
# URL do seu projeto Supabase
SUPABASE_URL=https://SEU-PROJETO.supabase.co

# Chave publicável (preferida) para autenticação e operações públicas
# Projetos legados também podem usar SUPABASE_ANON_KEY.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_sua-chave-aqui

# Chave secreta do backend (NUNCA expor no frontend ou versionar!)
# Projetos legados também podem usar SUPABASE_SERVICE_KEY (service_role).
SUPABASE_SECRET_KEY=sb_secret_sua-chave-aqui
